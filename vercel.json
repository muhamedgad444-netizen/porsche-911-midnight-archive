{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|hero_model/|gtr_model/|steeringwheel_model/|garageui/|basis/|draco/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
